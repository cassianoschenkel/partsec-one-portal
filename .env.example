# Database
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/partsec_one_portal?schema=public"

# Auth.js / NextAuth
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:4322"

# App public URL
APP_URL="http://localhost:4322"

# Integration credentials encryption
# Must be 64 hex characters: openssl rand -hex 32
INTEGRATION_CREDENTIALS_SECRET="generate-with-openssl-rand-hex-32"

# SMTP
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="smtp-user@example.com"
SMTP_PASS="smtp-password-or-app-password"
SMTP_FROM_NAME="Partsec One"
SMTP_FROM_EMAIL="no-reply@example.com"
