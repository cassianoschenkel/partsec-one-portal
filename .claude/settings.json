{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "blockReadsOutsideWorkingDirectories": true,
    "allow": [
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log)",
      "Bash(git log *)",
      "Bash(git show)",
      "Bash(git show *)",
      "Bash(git branch --show-current)",
      "Bash(git rev-parse *)",
      "Bash(npm ci)",
      "Bash(npm test)",
      "Bash(npm test *)",
      "Bash(npm run lint)",
      "Bash(npm run build)",
      "Bash(npx prisma generate)",
      "Bash(npx prisma validate)",
      "Bash(npx prisma format)",
      "Read(./.env.example)",
      "Edit(./.env.example)"
    ],
    "ask": [
      "Bash(git add *)",
      "Bash(git commit)",
      "Bash(git commit *)",
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(npm install)",
      "Bash(npm install *)",
      "Bash(npm i *)",
      "Bash(npm uninstall *)",
      "Bash(npx prisma migrate dev)",
      "Bash(npx prisma migrate dev *)",
      "Bash(prisma migrate dev)",
      "Bash(prisma migrate dev *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.local.*)",
      "Read(./.env.development)",
      "Read(./.env.development.local)",
      "Read(./.env.production)",
      "Read(./.env.production.local)",
      "Read(./.env.test)",
      "Read(./.env.test.local)",
      "Read(./.env.staging)",
      "Read(./.env.staging.local)",
      "Edit(./.env)",
      "Edit(./.env.local)",
      "Edit(./.env.local.*)",
      "Edit(./.env.development)",
      "Edit(./.env.development.local)",
      "Edit(./.env.production)",
      "Edit(./.env.production.local)",
      "Edit(./.env.test)",
      "Edit(./.env.test.local)",
      "Edit(./.env.staging)",
      "Edit(./.env.staging.local)",
      "Bash(sudo)",
      "Bash(sudo *)",
      "Bash(scripts/deploy.sh)",
      "Bash(scripts/deploy.sh *)",
      "Bash(bash scripts/deploy.sh*)",
      "Bash(sh scripts/deploy.sh*)",
      "Bash(./scripts/deploy.sh*)",
      "Bash(scripts/backup-db.sh)",
      "Bash(scripts/backup-db.sh *)",
      "Bash(bash scripts/backup-db.sh*)",
      "Bash(sh scripts/backup-db.sh*)",
      "Bash(./scripts/backup-db.sh*)",
      "Bash(npx prisma migrate deploy)",
      "Bash(npx prisma migrate deploy *)",
      "Bash(prisma migrate deploy)",
      "Bash(prisma migrate deploy *)",
      "Bash(npx prisma db push)",
      "Bash(npx prisma db push *)",
      "Bash(prisma db push)",
      "Bash(prisma db push *)",
      "Bash(git push --force)",
      "Bash(git push --force *)",
      "Bash(git push -f)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease)",
      "Bash(git push --force-with-lease *)",
      "Bash(git reset --hard)",
      "Bash(git reset --hard *)",
      "Bash(git clean -f)",
      "Bash(git clean -f *)",
      "Bash(git clean -fd)",
      "Bash(git clean -fd *)",
      "Bash(git clean -fdx)",
      "Bash(git clean -fdx *)",
      "Bash(git clean -df)",
      "Bash(git clean -df *)",
      "Bash(git clean -dfx)",
      "Bash(git clean -dfx *)",
      "Bash(psql)",
      "Bash(psql *)",
      "Bash(pg_dump)",
      "Bash(pg_dump *)",
      "Bash(pg_restore)",
      "Bash(pg_restore *)",
      "Bash(npx tsx scripts/set-initial-passwords.ts)",
      "Bash(npx tsx scripts/set-initial-passwords.ts *)",
      "Bash(npx tsx scripts/set-user-password.ts)",
      "Bash(npx tsx scripts/set-user-password.ts *)",
      "Bash(npx tsx scripts/set-siem-credentials.ts)",
      "Bash(npx tsx scripts/set-siem-credentials.ts *)",
      "Bash(npx tsx scripts/bootstrap-admin.ts)",
      "Bash(npx tsx scripts/bootstrap-admin.ts *)",
      "Bash(npx tsx scripts/sync-zabbix.ts)",
      "Bash(npx tsx scripts/sync-zabbix.ts *)",
      "Bash(npx tsx scripts/sync-siem-agents.ts)",
      "Bash(npx tsx scripts/sync-siem-agents.ts *)",
      "Bash(npx tsx scripts/sync-siem-vulnerabilities.ts)",
      "Bash(npx tsx scripts/sync-siem-vulnerabilities.ts *)",
      "Bash(npx tsx scripts/import-zabbix-assets.ts)",
      "Bash(npx tsx scripts/import-zabbix-assets.ts *)",
      "Bash(npx tsx scripts/debug-zabbix-problem-hosts.ts)",
      "Bash(npx tsx scripts/debug-zabbix-problem-hosts.ts *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/block-dangerous-bash.js",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
