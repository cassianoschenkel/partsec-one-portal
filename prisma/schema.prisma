generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  PARTSEC_ADMIN
  TENANT_ADMIN
  TENANT_USER
  READ_ONLY
}

enum AssetType {
  SERVER
  WORKSTATION
  FIREWALL
  SWITCH
  ROUTER
  ACCESS_POINT
  LINK
  SERVICE
  OTHER
}

enum IntegrationType {
  ZABBIX
  WAZUH
  ZAMMAD
}

enum IntegrationStatus {
  ACTIVE
  INACTIVE
  ERROR
}

model Tenant {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  document    String?
  isActive    Boolean  @default(true)

  users       User[]
  assets      CustomerAsset[]
  integrations IntegrationConfig[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("tenants")

  zabbixHostSnapshots    ZabbixHostSnapshot[]
  zabbixProblemSnapshots ZabbixProblemSnapshot[]
  integrationSyncLogs    IntegrationSyncLog[]
}

model User {
  id           String   @id @default(cuid())
  tenantId     String?
  name         String
  email        String   @unique
  passwordHash String?
  role         UserRole @default(TENANT_USER)
  isActive     Boolean  @default(true)

  tenant       Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  passwordSetupTokens PasswordSetupToken[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([tenantId])
  @@map("users")
}

model PasswordSetupToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("password_setup_tokens")
}

model CustomerAsset {
  id              String    @id @default(cuid())
  tenantId        String
  name            String
  hostname        String?
  ipAddress       String?
  assetType       AssetType @default(SERVER)
  operatingSystem String?
  description     String?

  zabbixHostId    String?
  wazuhAgentId    String?

  isActive        Boolean   @default(true)

  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([tenantId])
  @@index([zabbixHostId])
  @@index([wazuhAgentId])
  @@map("customer_assets")
}

model IntegrationConfig {
  id              String            @id @default(cuid())
  tenantId        String
  type            IntegrationType
  status          IntegrationStatus @default(INACTIVE)

  displayName     String
  baseUrl         String?
  externalGroupId String?
  externalOrgId   String?

  notes           String?

  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  credentials     IntegrationCredential[]

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([tenantId])
  @@unique([tenantId, type])
  @@map("integration_configs")
}

model IntegrationCredential {
  id                  String            @id @default(cuid())
  integrationConfigId String
  key                 String
  encryptedValue      String

  integrationConfig   IntegrationConfig @relation(fields: [integrationConfigId], references: [id], onDelete: Cascade)

  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@index([integrationConfigId])
  @@unique([integrationConfigId, key])
  @@map("integration_credentials")
}
model ZabbixHostSnapshot {
  id          String   @id @default(cuid())
  tenantId    String
  zabbixHostId String
  host        String
  name        String
  status      String
  interfaceIp String?
  interfaceDns String?
  rawData     Json?

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  syncedAt    DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
  @@index([zabbixHostId])
  @@unique([tenantId, zabbixHostId])
  @@map("zabbix_host_snapshots")
}

model ZabbixProblemSnapshot {
  id            String   @id @default(cuid())
  tenantId      String
  eventId       String
  objectId      String?
  name          String
  severity      String
  clock         String
  acknowledged  String

  zabbixHostId      String?
  hostName          String?
  hostTechnicalName String?

  status     String   @default("OPEN")
  resolvedAt DateTime?
  lastSeenAt DateTime?

  rawData       Json?

  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  syncedAt      DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tenantId])
  @@index([eventId])
  @@unique([tenantId, eventId])
  @@map("zabbix_problem_snapshots")
}

model IntegrationSyncLog {
  id            String          @id @default(cuid())
  tenantId      String
  integrationType IntegrationType
  status        String
  message       String?
  startedAt     DateTime        @default(now())
  finishedAt    DateTime?
  durationMs    Int?

  tenant        Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([integrationType])
  @@index([startedAt])
  @@map("integration_sync_logs")
}
